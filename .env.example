# ── Hermes ──
# Hermes home directory (or a Hermes profile directory). Default: ~/.hermes
# HERMES_HOME=~/.hermes

# ── Hermesume state (cursor, metadata, dream logs, archives) ──
# HERMESUME_HOME=~/.hermesume

# ── Embedding Provider ──
# Options: "openai" (default), "ollama", "sentence-transformers"
HERMESUME_EMBEDDING_PROVIDER=openai

# OpenAI (required if any provider=openai)
OPENAI_API_KEY=your_openai_api_key
# Any OpenAI-compatible endpoint works for the LLM (OpenRouter, vLLM, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# HERMESUME_OPENAI_LLM_MODEL=gpt-4.1-nano

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_LLM_MODEL=qwen2.5:3b

# Sentence-transformers
# ST_MODEL_NAME=all-MiniLM-L6-v2

# ── LLM Provider ──
# Options: "openai" (default), "ollama", "minimax"
HERMESUME_LLM_PROVIDER=openai
# MINIMAX_API_KEY=

# ── Tuning ──
# HERMESUME_FILL_RATIO=0.85          # fill memory files up to 85% of Hermes' limit
# HERMESUME_EXCLUDE_SOURCES=cron     # session sources to skip
# HERMESUME_SESSION_SETTLE_SECONDS=1800
