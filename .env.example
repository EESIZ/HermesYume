# ── Hermes ──
# Hermes home directory (or a Hermes profile directory). Default: ~/.hermes
# HERMES_HOME=~/.hermes

# ── HermesYume state (cursor, metadata, dream logs, archives) ──
# HERMESYUME_HOME=~/.hermesyume

# ── API keys ──
# Nothing to set if Hermes already has DEEPSEEK_API_KEY (or OPENAI_API_KEY) in
# $HERMES_HOME/.env -- HermesYume reads those two from there automatically.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ── Embedding Provider ──
# Options: "auto" (default), "openai", "ollama", "sentence-transformers", "hash"
# auto = openai if OPENAI_API_KEY, else sentence-transformers if installed, else hash
# HERMESYUME_EMBEDDING_PROVIDER=auto
# Any OpenAI-compatible endpoint works for the LLM (OpenRouter, vLLM, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# HERMESYUME_OPENAI_LLM_MODEL=gpt-4.1-nano

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_LLM_MODEL=qwen2.5:3b

# Sentence-transformers
# ST_MODEL_NAME=all-MiniLM-L6-v2

# ── LLM Provider ──
# Options: "auto" (default), "deepseek", "openai", "ollama", "minimax"
# auto = deepseek if DEEPSEEK_API_KEY, else openai
# HERMESYUME_LLM_PROVIDER=auto
# HERMESYUME_DEEPSEEK_MODEL=deepseek-v4-flash
# MINIMAX_API_KEY=

# ── Tuning ──
# HERMESYUME_FILL_RATIO=0.85          # fill memory files up to 85% of Hermes' limit
# HERMESYUME_EXCLUDE_SOURCES=cron     # session sources to skip
# HERMESYUME_SESSION_SETTLE_SECONDS=1800
