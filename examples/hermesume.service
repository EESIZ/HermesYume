[Unit]
Description=Hermesume -- Hermes Agent memory consolidation
After=network-online.target

[Service]
Type=oneshot
User=YOUR_USER
EnvironmentFile=/home/YOUR_USER/.env
Environment=HERMES_HOME=/home/YOUR_USER/.hermes
Environment=HERMESUME_HOME=/home/YOUR_USER/.hermesume
WorkingDirectory=/path/to/hermesume
ExecStart=/usr/bin/python3 hermesume.py --verbose
StandardOutput=append:/home/YOUR_USER/.hermesume/dream-log/cron.log
StandardError=append:/home/YOUR_USER/.hermesume/dream-log/cron.log
